<viewsettings>
    <scheme name="defence">
        <background backgroundColor="30,34,40" showGrid="0"/>
        <edges laneEdgeMode="0" laneShowBorders="1" showLinkDecals="1" showRails="0" hideConnectors="1" widthExaggeration="2.00" showDirection="0">
            <colorScheme name="uniform">
                <entry color="110,116,126" name="road"/>
                <entry color="grey" name="sidewalk"/>
                <entry color="192,66,44" name="bike lane"/>
                <entry color="200,255,200" name="green verge"/>
                <entry color="150,200,200" name="waterway"/>
                <entry color="black" name="railway"/>
                <entry color="200,240,240" name="rails on road"/>
                <entry color="255,0,255" name="no passenger"/>
                <entry color="red" name="closed"/>
                <entry color="green" name="connector"/>
                <entry color="orange" name="forbidden"/>
            </colorScheme>
        </edges>
        <vehicles vehicleMode="8" vehicleQuality="2" vehicle_minSize="1.00" vehicle_exaggeration="2.50" vehicle_constantSize="0" showBlinker="1">
            <colorScheme name="by speed" interpolated="1">
                <entry color="red" threshold="0.00"/>
                <entry color="yellow" threshold="4.00"/>
                <entry color="green" threshold="10.00"/>
            </colorScheme>
        </vehicles>
        <junctions junctionMode="0" drawLinkTLIndex="0" drawLinkJunctionIndex="0" drawCrossingsAndWalkingareas="0">
            <colorScheme name="uniform">
                <entry color="110,116,126" name="junction"/>
            </colorScheme>
        </junctions>
    </scheme>
    <delay value="0"/>
</viewsettings>
